# Single public port: static exported frontend + Reflex backend/WebSocket proxy.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# Reflex backend routes (the /_event WebSocket upgrade passes through).
	@backend path /_event* /_upload* /_health* /_all_routes* /ping*
	handle @backend {
		reverse_proxy 127.0.0.1:{$BACKEND_PORT:8000} {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else: the exported static frontend.
	handle {
		root * {$FRONTEND_DIR:/app/.web/build/client}
		try_files {path} {path}/ {path}.html /404.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
